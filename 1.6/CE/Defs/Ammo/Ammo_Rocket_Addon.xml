<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- ======= AmmoSet ======= -->
	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_50mmRocket_directfire</defName>
		<label>50mm rocket</label>
		<ammoTypes>
			<Ammo_50mmRocket_HE>Bullet_50mmRocket_HE_directfire</Ammo_50mmRocket_HE>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<!-- ======= Projectiles ======= -->
	<ThingDef ParentName="Base50mmRocket">
		<defName>Bullet_50mmRocket_HE_directfire</defName>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<label>50mm rocket (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/Rocket/70mmAPKWS</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.70</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>Bomb</damageDef>
			<damageAmountBase>147</damageAmountBase>
			<explosionRadius>2.5</explosionRadius>
			<flyOverhead>false</flyOverhead>
			<gravityFactor>1</gravityFactor>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Small>23</Fragment_Small>
				</fragments>
			</li>
			<li Class="CombatExtended.CompProperties_ProjectileFleck">
				<FleckDatas>
					<li>
						<fleck>Fleck_CERocketFlame</fleck>
						<emissionsPerTick>7</emissionsPerTick>
						<flecksPerEmission>3</flecksPerEmission>
						<cutoffTickRange>60~120</cutoffTickRange>
					</li>
					<li>
						<fleck>Fleck_CERocketSmokeTrail</fleck>
						<emissionsPerTick>0.5</emissionsPerTick>
						<rotation>0~360</rotation>
						<scale>2</scale>
						<flecksPerEmission>1</flecksPerEmission>
					</li>
					<li>
						<fleck>Fleck_CERocketSmoke</fleck>
						<emissionsPerTick>0.5</emissionsPerTick>
						<rotation>0~360</rotation>
						<flecksPerEmission>1</flecksPerEmission>
						<cutoffTickRange>120~240</cutoffTickRange>
					</li>
				</FleckDatas>
			</li>
		</comps>
	</ThingDef>

</Defs>