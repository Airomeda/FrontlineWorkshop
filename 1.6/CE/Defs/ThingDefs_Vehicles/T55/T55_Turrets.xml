	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>FW_SGMTCoaxial_Turret</defName>
		<label>SGMT coaxial machinegun</label>
		<description>SGMT machinegun loaded with 7.62x54mmR.</description>
		<turretType>Rotatable</turretType>
		<shotSound>MediumMG</shotSound>
		<projectile>Bullet_762x54mmR_FMJ</projectile>
		<reloadTimer>7.8</reloadTimer>
		<warmUpTimer>1.3</warmUpTimer>
		<magazineCapacity>200</magazineCapacity>
		<genericAmmo>false</genericAmmo>
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>2.0</rotationSpeed>
		<projectileOffset>0.15</projectileOffset>
		<maxRange>62</maxRange>
		<attachProjectileFlag>Tank</attachProjectileFlag>
		<fireModes>
			<li>
				<shotsPerBurst>10</shotsPerBurst>
				<ticksBetweenShots>6</ticksBetweenShots>
				<ticksBetweenBursts>30</ticksBetweenBursts>
				<spreadRadius>1</spreadRadius>
				<label>Burst</label>
				<texPath>UI/Gizmos/FireRate_Burst</texPath>
			</li>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>6</ticksBetweenShots>
				<ticksBetweenBursts>30</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Gizmos/FireRate_Single</texPath>
			</li>
			<li>
				<shotsPerBurst>25</shotsPerBurst>
				<ticksBetweenShots>6</ticksBetweenShots>
				<ticksBetweenBursts>30</ticksBetweenBursts>
				<label>Auto</label>
				<texPath>UI/Gizmos/FireRate_Auto</texPath>
			</li>
		</fireModes>
		<graphicData>
			<texPath>Things/Vehicles/None</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(1, 1)</drawSize>
		</graphicData>
		<gizmoIconTexPath>Things/Vehicles/T55/T55Coaxial_TurretGizmo</gizmoIconTexPath>
		<gizmoIconScale>1.1</gizmoIconScale>
		<ammunition>
			<thingDefs>
				<li>Ammo_762x54mmR_FMJ</li>
				<li>Ammo_762x54mmR_AP</li>
				<li>Ammo_762x54mmR_Incendiary</li>
				<li>Ammo_762x54mmR_HE</li>
				<li>Ammo_762x54mmR_Sabot</li>
			</thingDefs>
		</ammunition>
		<modExtensions>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_762x54mmR</ammoSet>
				<shotHeight>2</shotHeight>
				    <!-- <speed>159</speed> -->
				<sway>0.96</sway>
				<spread>0.04</spread>
			</li>
		</modExtensions>
	</Vehicles.VehicleTurretDef>

