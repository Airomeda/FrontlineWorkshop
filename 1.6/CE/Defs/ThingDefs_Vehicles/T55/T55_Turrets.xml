<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>FW_D10TCannonA_Turret</defName>
		<label>D-10T cannon</label>
		<description>D-10T cannon loaded with 100x695mmR Shell.</description>
		<turretType>Rotatable</turretType>
		<shotSound>FW_Shot_D10TSound</shotSound>
		<projectile>Bullet_100x695mmRCannonShell_HEAT</projectile>
		<reloadSound>Artillery_ShellLoaded</reloadSound>
		<reloadTimer>8.0</reloadTimer>
		<reloadTimerMultiplierPerCrewCount>
			<points>
				<li>(1, 1)</li>
				<li>(2, 0.75)</li>
			</points>
		</reloadTimerMultiplierPerCrewCount>
		<warmUpTimer>2.8</warmUpTimer>
		<magazineCapacity>1</magazineCapacity>
		<genericAmmo>false</genericAmmo>
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>1.5</rotationSpeed>
		<projectileOffset>3.75</projectileOffset>
		<projectileShifting>
			<li>-0.1</li>
		</projectileShifting>
		<minRange>4</minRange>
		<maxRange>86</maxRange>
		<attachProjectileFlag>Tank</attachProjectileFlag>
		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>12</ticksBetweenShots>
				<ticksBetweenBursts>60</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Gizmos/FireRate_Single</texPath>
			</li>
		</fireModes>
		<gizmoIconTexPath>Things/Vehicles/T55/D10TCannonA_TurretGizmo</gizmoIconTexPath>
		<gizmoIconScale>1.05</gizmoIconScale>
		<graphicData>
			<texPath>Things/Vehicles/T55/D10TCannonA_Top</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(9.25, 9.25)</drawSize>
		</graphicData>
		<graphics>
			<li>
				<graphicData>
					<texPath>Things/Vehicles/T55/D10TCannon_Barrel</texPath>
					<graphicClass>Vehicles.Graphic_Turret</graphicClass>
					<shaderType>CutoutComplexPattern</shaderType>
					<drawSize>(9.25, 9.25)</drawSize>
				</graphicData>
				<recoil>
					<distanceTotal>0.35</distanceTotal>
					<distancePerTick>0.05</distancePerTick>
					<speedMultiplierPostRecoil>0.1</speedMultiplierPostRecoil>
				</recoil>
			</li>
		</graphics>
		<ammunition>
			<thingDefs>
				<li>Ammo_100x695mmRCannonShell_HEAT</li>
				<li>Ammo_100x695mmRCannonShell_HE</li>
				<li>Ammo_100x695mmRCannonShell_EMP</li>
			</thingDefs>
		</ammunition>
		<motes>
			<li>
				<cycles>1</cycles>
				<moteDef>Mote_CannonPlume</moteDef>
				<offset>(0, 0, 2.75)</offset>
				<animationType>Reset</animationType>
			</li>
		</motes>
		<modExtensions>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_100x695mmRCannonShell</ammoSet>
				<shotHeight>2.25</shotHeight>
				<!-- <speed>165</speed> -->
				<sway>0.82</sway>
				<spread>0.01</spread>
			</li>
		</modExtensions>
	</Vehicles.VehicleTurretDef>

