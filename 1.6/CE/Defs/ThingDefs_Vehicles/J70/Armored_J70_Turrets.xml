<Defs>

	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>FW_2A28Cannon_Turret</defName>
		<label>2A28 cannon</label>
		<description>2A28 cannon loaded with SPG-9 rocket.</description>
		<turretType>Rotatable</turretType>
		<shotSound>FW_Shot_2A28Sound</shotSound>
		<projectile>Bullet_SPG9Rocket_HEAT</projectile>
		<reloadSound>Artillery_ShellLoaded</reloadSound>
		<reloadTimer>6</reloadTimer>
		<reloadTimerMultiplierPerCrewCount>
			<points>
				<li>(1, 1)</li>
				<li>(2, 0.75)</li>
			</points>
		</reloadTimerMultiplierPerCrewCount>
		<warmUpTimer>1.5</warmUpTimer>
		<magazineCapacity>1</magazineCapacity>
		<genericAmmo>false</genericAmmo>
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>1.2</rotationSpeed>
		<projectileOffset>1.9</projectileOffset>
		<projectileShifting>
			<li>-0.05</li>
		</projectileShifting>
		<minRange>8</minRange>
		<maxRange>92</maxRange>
		<attachProjectileFlag>Tank</attachProjectileFlag>
		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>1</ticksBetweenShots>
				<ticksBetweenBursts>3</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Gizmos/FireRate_Single</texPath>
			</li>
		</fireModes>
		<gizmoIconTexPath>Things/Vehicles/J70/Armored/2A28Cannon_TurretGizmo</gizmoIconTexPath>
		<gizmoIconScale>1.05</gizmoIconScale>
		<graphicData>
			<texPath>Things/Vehicles/J70/Armored/2A28Cannon_Top</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(3.5, 3.5)</drawSize>
		</graphicData>
		<graphics>
			<li>
				<graphicData>
					<texPath>Things/Vehicles/J70/Armored/2A28Cannon_Barrel</texPath>
					<graphicClass>Vehicles.Graphic_Turret</graphicClass>
					<shaderType>CutoutComplexPattern</shaderType>
					<drawSize>(3.5, 3.5)</drawSize>
				</graphicData>
				<recoil>
					<distanceTotal>0.2</distanceTotal>
					<distancePerTick>0.05</distancePerTick>
					<speedMultiplierPostRecoil>0.1</speedMultiplierPostRecoil>
				</recoil>
			</li>
		</graphics>
		<ammunition>
			<thingDefs>
				<li>Ammo_SPG9Rocket_HEAT</li>
				<li>Ammo_SPG9Rocket_Thermobaric</li>
				<li>Ammo_SPG9Rocket_Frag</li>
				<li>Ammo_SPG9Rocket_EMP</li>
			</thingDefs>
		</ammunition>
		<motes>
			<li>
				<cycles>1</cycles>
				<moteDef>Mote_CannonPlume</moteDef>
				<offset>(0, 0, 2)</offset>
				<animationType>Reset</animationType>
			</li>
		</motes>
		<modExtensions>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_SPG9Rocket</ammoSet>
				<shotHeight>2.0</shotHeight>
				<sway>0.82</sway>
				<spread>0.01</spread>
			</li>
		</modExtensions>
	</Vehicles.VehicleTurretDef>

