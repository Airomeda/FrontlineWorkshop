<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>FW_RH202Autocannon_Turret</defName>
		<label>RH202 autocannon turret</label>
		<description>RH202 autocannon loaded with 20x139mm.</description>
		<turretType>Rotatable</turretType>
		<shotSound>FW_Shot_RH202Sound</shotSound>
		<projectile>Bullet_20x139mm_AP</projectile>
		<reloadTimer>10.4</reloadTimer>
		<warmUpTimer>1.3</warmUpTimer>
		<magazineCapacity>100</magazineCapacity>
		<genericAmmo>false</genericAmmo>
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>2.0</rotationSpeed>
		<projectileOffset>1.6</projectileOffset>
		<projectileShifting>
			<li>0</li>
		</projectileShifting>
		<minRange>2</minRange>
		<maxRange>80</maxRange>
		<attachProjectileFlag>Tank</attachProjectileFlag>
		<fireModes>
			<li>
				<shotsPerBurst>5</shotsPerBurst>
				<ticksBetweenShots>4</ticksBetweenShots>
				<ticksBetweenBursts>30</ticksBetweenBursts>
				<label>Burst</label>
				<texPath>UI/Gizmos/FireRate_Burst</texPath>
			</li>
			<li>
				<shotsPerBurst>50</shotsPerBurst>
				<ticksBetweenShots>6</ticksBetweenShots>
				<ticksBetweenBursts>60</ticksBetweenBursts>
				<label>Auto</label>
				<texPath>UI/Gizmos/FireRate_Auto</texPath>
			</li>
			<li>
				<shotsPerBurst>25</shotsPerBurst>
				<ticksBetweenShots>8</ticksBetweenShots>
				<ticksBetweenBursts>60</ticksBetweenBursts>
				<label>Sustained</label>
				<texPath>UI/Gizmos/FireRate_Burst</texPath>
			</li>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>2</ticksBetweenShots>
				<ticksBetweenBursts>10</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Gizmos/FireRate_Single</texPath>
			</li>
		</fireModes>
		<cooldown>
			<heatPerShot>1.5</heatPerShot>
			<dissipationRate>0.25</dissipationRate>
			<dissipationCapMultiplier>1</dissipationCapMultiplier>
		</cooldown>
		<gizmoIconTexPath>Things/Vehicles/Wiesel/RH202Autocannon_TurretGizmo</gizmoIconTexPath>
		<gizmoIconScale>1.05</gizmoIconScale>
		<graphicData>
			<texPath>Things/Vehicles/Wiesel/RH202Autocannon_Top</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(5.5, 5.5)</drawSize>
		</graphicData>
		<graphics>
			<li>
				<graphicData>
					<texPath>Things/Vehicles/Wiesel/RH202Autocannon_Barrel</texPath>
					<graphicClass>Vehicles.Graphic_Turret</graphicClass>
					<shaderType>CutoutComplexPattern</shaderType>
					<drawSize>(5.5, 5.5)</drawSize>
				</graphicData>
				<recoil>
					<distanceTotal>0.10</distanceTotal>
					<distancePerTick>0.1</distancePerTick>
					<speedMultiplierPostRecoil>0.25</speedMultiplierPostRecoil>
				</recoil>
			</li>
		</graphics>
		<ammunition>
			<thingDefs>
				<li>Ammo_20x139mm_AP</li>
				<li>Ammo_20x139mm_Incendiary</li>
				<li>Ammo_20x139mm_HE</li>
				<li>Ammo_20x139mm_Sabot</li>
			</thingDefs>
		</ammunition>
		<motes>
			<li>
				<cycles>1</cycles>
				<moteDef>FW_Mote_AutocannonPlume</moteDef>
				<offset>(-0.2, 0, 2)</offset>
				<animationType>Reset</animationType>
			</li>
		</motes>
		<modExtensions>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_20x139mm</ammoSet>
				<shotHeight>1.85</shotHeight>
				<!-- <speed>178</speed> -->
				<sway>1.42</sway>
				<spread>0.05</spread>
				<recoil>1.25</recoil>
			</li>
		</modExtensions>
	</Vehicles.VehicleTurretDef>

	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>FW_WieselMG3LMG_Turret</defName>
		<label>Wiesel MG3 turret</label>
		<description>MG3 light machine gun loaded with 7.62x51mm NATO.</description>
		<turretType>Rotatable</turretType>
		<shotSound>Shot_Minigun</shotSound>
		<projectile>Bullet_762x51mmNATO_FMJ</projectile>
		<reloadTimer>7.8</reloadTimer>
		<warmUpTimer>1.1</warmUpTimer>
		<magazineCapacity>100</magazineCapacity>
		<genericAmmo>false</genericAmmo>
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>2.0</rotationSpeed>
		<projectileOffset>0.15</projectileOffset>
		<maxRange>75</maxRange>
		<attachProjectileFlag>Tank</attachProjectileFlag>
		<fireModes>
			<li>
				<shotsPerBurst>30</shotsPerBurst>
				<ticksBetweenShots>3</ticksBetweenShots>
				<ticksBetweenBursts>30</ticksBetweenBursts>
				<label>Auto</label>
				<texPath>UI/Gizmos/FireRate_Auto</texPath>
			</li>
			<li>
				<shotsPerBurst>15</shotsPerBurst>
				<ticksBetweenShots>3</ticksBetweenShots>
				<ticksBetweenBursts>30</ticksBetweenBursts>
				<spreadRadius>1</spreadRadius>
				<label>Burst</label>
				<texPath>UI/Gizmos/FireRate_Burst</texPath>
			</li>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>3</ticksBetweenShots>
				<ticksBetweenBursts>30</ticksBetweenBursts>
				<label>Single</label>
				<texPath>UI/Gizmos/FireRate_Single</texPath>
			</li>
		</fireModes>
		<graphicData>
			<texPath>Things/Vehicles/Wiesel/MG3_LMG</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(2.25, 2.25)</drawSize>
		</graphicData>
		<gizmoIconTexPath>Things/Vehicles/Wiesel/MG3_LMG</gizmoIconTexPath>
		<gizmoIconScale>1.2</gizmoIconScale>
		<ammunition>
			<thingDefs>
				<li>Ammo_762x51mmNATO_FMJ</li>
				<li>Ammo_762x51mmNATO_AP</li>
				<li>Ammo_762x51mmNATO_Incendiary</li>
				<li>Ammo_762x51mmNATO_HE</li>
				<li>Ammo_762x51mmNATO_Sabot</li>
			</thingDefs>
		</ammunition>
		<modExtensions>
			<li Class="Vehicles.CETurretDataDefModExtension">
				<ammoSet>AmmoSet_762x51mmNATO</ammoSet>
				<shotHeight>2</shotHeight>
				<!-- <speed>159</speed> -->
				<sway>1.27</sway>
				<spread>0.05</spread>
			</li>
		</modExtensions>
	</Vehicles.VehicleTurretDef>

</Defs>